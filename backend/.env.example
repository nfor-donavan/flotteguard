# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flotteguard?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (receipt / ID document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS gateway (document expiry alerts) - plug in your local provider (e.g. Nexah, Twilio)
SMS_GATEWAY_API_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=FlotteGuard

# Orange Money
ORANGE_MONEY_API_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=

# MTN Mobile Money
MTN_MOMO_API_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173
